# ── AI gateway (all LLM calls route through here) ───────────────────────────
AI_GATEWAY_URL=
BIFROST_VIRTUAL_KEY=

# ── Models ("provider/model"; bare names are treated as anthropic/…) ───────
# CHAT_MODEL drives the conversation and must support tool calling through the gateway.
CHAT_MODEL=anthropic/claude-sonnet-5-5
CONTENT_MODEL=anthropic/claude-sonnet-5-5
LONGFORM_MODEL=anthropic/claude-opus-5-5
VERIFY_MODEL=anthropic/claude-haiku-5-5

# ── Docs repo (fine-grained token: Contents = Read on this repo only) ───────
GITHUB_TOKEN=
DOCS_REPO=CalfusAgentFoundry/lore
DOCS_BRANCH=main
# Comma-separated folders. kb/ is left out on purpose: it is older than content/docs.
DOCS_PATHS=content/docs
# Set for GitHub Enterprise, e.g. https://github.acme.com/api/v3
GITHUB_API_URL=https://api.github.com

# ── Jira Cloud (read-only service account with Browse projects) ─────────────
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated project keys the agent may read, e.g. AP
JIRA_PROJECTS=

# ── Storage (conversation memory + generated files) ─────────────────────────
# In chat, files go to the conversation's customer bucket; TENANT_ID is the local fallback.
TENANT_ID=
APP_ENV=local
# Local only: write to ./output instead of object storage
LOCAL_OUTPUT=false

# ── Temporal task queues (must be unique per project) ───────────────────────
AETHERION_AGENT_TASK_QUEUE=pr-marketing-chat-agent-CHANGE-ME
AETHERION_TOOL_TASK_QUEUE=pr-marketing-chat-tool-CHANGE-ME
