# Copy to .env and fill in. Never commit .env.

# ── Storage / tenancy ───────────────────────────────────────────────────────
# Used as the object-storage bucket for reports and run markers.
TENANT_ID=
# Local only: write reports/run markers to ./output instead of object storage
LOCAL_OUTPUT=false

# ── AI Gateway (LLM access; provider keys live in the gateway) ──────────────
# Usually supplied by the workspace/deploy environment.
AI_GATEWAY_URL=
BIFROST_VIRTUAL_KEY=

# ── GitHub (read-only fine-grained token: Pull requests + Metadata = Read) ──
GITHUB_TOKEN=
# Set for GitHub Enterprise, e.g. https://github.acme.com/api/v3
GITHUB_API_URL=https://api.github.com

# ── Confluence (read-only) ──────────────────────────────────────────────────
# e.g. https://calfus.atlassian.net/wiki. Its host is an approved host for
# "Feature documentation:" links in PR descriptions.
CONFLUENCE_BASE_URL=
# Extra approved hosts, comma-separated (e.g. a self-hosted wiki). Exact match.
CONFLUENCE_ALLOWED_HOSTS=
# Atlassian account email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# ── PR selection ────────────────────────────────────────────────────────────
# Change types that are always marketable; fix/chore/refactor/... are excluded.
INCLUDE_TYPES=feat,perf
# PRs with this label are always included, whatever their type.
FORCE_INCLUDE_LABEL=marketing
# Eligible PRs per scheduled run; the rest wait for the next run.
MAX_PRS_PER_RUN=30
# Safety cap on PRs listed per repo per run (oldest kept, so none are skipped).
MAX_CANDIDATES_PER_REPO=500

# ── Task queues (must be unique per project) ────────────────────────────────
AETHERION_AGENT_TASK_QUEUE=pr-marketing-v2-agent-CHANGE-ME
AETHERION_TOOL_TASK_QUEUE=pr-marketing-v2-tool-CHANGE-ME

# ── Jira (read-only; issues linked from PR titles/branches/descriptions) ───
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Only keys from these projects are read, comma-separated (e.g. AP,PLAT).
JIRA_PROJECTS=

# ── Product catalog updater ─────────────────────────────────────────────────
PRODUCT_ID=aetherion
# Docs site whose llms-full.txt is snapshotted and diffed each run.
DOCS_SITE_URL=https://calfus.dev.aetherion.io/docs
# Models per step ("provider/model"). Verify/check default to a different model
# from the writers so the reviewer doesn't share their blind spots.
ROUTE_MODEL=anthropic/claude-haiku-5-5
EXTRACT_MODEL=anthropic/claude-sonnet-5-5
VERIFY_MODEL=anthropic/claude-opus-5-5
COMPOSE_MODEL=anthropic/claude-sonnet-5-5
CHECK_MODEL=anthropic/claude-opus-5-5
# The chat agent reads the catalog from this same bucket (TENANT_ID): set its
# CATALOG_BUCKET to the same value if its TENANT_ID differs.
