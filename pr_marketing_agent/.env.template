# ── Bifrost gateway (all LLM calls route through here) ──────────────────────
BIFROST_URL=
BIFROST_VIRTUAL_KEY=

# ── Models per step (Bifrost names; "anthropic/" is added automatically) ────
TRIAGE_MODEL=claude-haiku-5-5
VERIFY_MODEL=claude-haiku-5-5
ANALYSIS_MODEL=claude-sonnet-5-5
CONTENT_MODEL=claude-sonnet-5-5
LONGFORM_MODEL=claude-opus-5-5

# ── GitHub (read-only fine-grained token: Contents + Pull requests = Read) ──
GITHUB_TOKEN=
# Set for GitHub Enterprise, e.g. https://github.acme.com/api/v3
GITHUB_API_URL=https://api.github.com

# ── Storage (reports + scheduled-run cursors) ───────────────────────────────
TENANT_ID=
APP_ENV=local
# Local only: write reports/cursors to ./output instead of S3
LOCAL_OUTPUT=false

# ── Limits ──────────────────────────────────────────────────────────────────
DIFF_CHAR_BUDGET=60000
MAX_PRS_PER_RUN=30

# ── Temporal task queues (must be unique per project) ───────────────────────
AETHERION_AGENT_TASK_QUEUE=pr-marketing-agent-CHANGE-ME
AETHERION_TOOL_TASK_QUEUE=pr-marketing-tool-CHANGE-ME
